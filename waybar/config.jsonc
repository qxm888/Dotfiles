{
    "layer": "top",
    "position": "top",
    "height": 28,
    "spacing": 6,
    "margin-top": 0,
    "margin-left": 12,
    "margin-right": 12,
    "margin-bottom": 0,

    "modules-left": [
        "custom/launcher",
        "clock",
        "cpu",
        "custom/gpu",
        "memory",
        "custom/window"
    ],
    "modules-center": [
        "custom/workspaces"
    ],
    "modules-right": [
        "mpris",
        "network",
        "bluetooth",
        "tray",
        "custom/notification",
        "pulseaudio"
    ],

    "custom/launcher": {
        "format": "",
        "on-click": "~/.config/waybar/scripts/launcher.sh",
        "tooltip-format": "Launcher (walker / rofi)"
    },

    "clock": {
        "format": "{:%m/%d %a %H:%M}",
        "tooltip-format": "<big>{:%Y年%B%d日}</big>\n<tt><small>{calendar}</small></tt>"
    },

    "cpu": {
        "format": "󰍛 {usage}%",
        "states": {
            "warning": 60,
            "critical": 85
        }
    },

    "custom/gpu": {
        "exec": "~/.config/waybar/scripts/gpu.sh",
        "interval": 3,
        "return-type": "json"
    },

    "memory": {
        "format": "󰘚 {percentage}%",
        "states": {
            "warning": 70,
            "critical": 90
        }
    },

    "custom/window": {
        "exec": "~/.config/waybar/scripts/window.sh",
        "interval": 1,
        "return-type": "json",
        "max-length": 40
    },

    "custom/workspaces": {
        "exec": "~/.config/waybar/scripts/workspaces.sh",
        "interval": 1,
        "return-type": "json",
        "on-click": "~/.config/waybar/scripts/workspace-switch.sh next",
        "on-click-right": "~/.config/waybar/scripts/workspace-switch.sh prev",
        "on-scroll-up": "~/.config/waybar/scripts/workspace-switch.sh next",
        "on-scroll-down": "~/.config/waybar/scripts/workspace-switch.sh prev",
        "escape": false
    },

    "mpris": {
        "format": "{player_icon} {artist} - {title}",
        "format-playing": "{player_icon} {artist} - {title}",
        "format-paused": "{status_icon} {artist} - {title}",
        "format-stopped": "",
        "max-length": 35,
        "tooltip-format": "{title} - {artist}\n{album}",
        "on-click": "playerctl play-pause",
        "on-click-right": "playerctl stop",
        "on-scroll-up": "playerctl next",
        "on-scroll-down": "playerctl previous",
        "player-icons": {
            "default": "󰐍",
            "spotify": "󰓇",
            "firefox": "󰈹",
            "chromium": "󰊯",
            "mpv": "󰐹"
        },
        "status-icons": {
            "playing": "󰏤",
            "paused": "󰐊"
        }
    },

    "network": {
        "format": "{icon}",
        "format-wifi": "󰤨",
        "format-ethernet": "󰈀",
        "format-disconnected": "󰤮",
        "format-linked": "󰤦",
        "tooltip-format": "{ifname}: {essid} ({signalStrength}%)\n{ipaddr}",
        "on-click": "nm-connection-editor"
    },

    "bluetooth": {
        "format": "{icon}",
        "format-on": "󰂯",
        "format-off": "󰂲",
        "format-connected": "󰂱",
        "tooltip-format": "{status}",
        "on-click": "blueman-manager"
    },

    "tray": {
        "icon-size": 16,
        "spacing": 6
    },

    "custom/notification": {
        "format": "󰂚",
        "on-click": "swaync-client -t",
        "tooltip-format": "Notification Center"
    },

    "pulseaudio": {
        "format": "{icon}",
        "format-muted": "󰝟",
        "format-source": "󰍬",
        "format-source-muted": "󰍭",
        "format-icons": {
            "default": ["󰕾"]
        },
        "on-click": "pwvucontrol",
        "tooltip-format": "{desc}\nVolume: {volume}%"
    }
}
