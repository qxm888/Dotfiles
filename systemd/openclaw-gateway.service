[Unit]
Description=OpenClaw Gateway (v2026.5.22)
After=network-online.target
Wants=network-online.target
StartLimitBurst=5
StartLimitIntervalSec=60

[Service]
ExecStart=/usr/bin/node /home/dovahkiin/.npm-global/lib/node_modules/openclaw/dist/index.js gateway --port 50288
Restart=always
RestartSec=5
RestartPreventExitStatus=78
TimeoutStopSec=30
TimeoutStartSec=30
SuccessExitStatus=0 143
KillMode=control-group
Environment=HOME=/home/dovahkiin
Environment=TMPDIR=/tmp
Environment=PATH=/usr/bin:/home/dovahkiin/.npm-global/bin:/home/dovahkiin/.local/bin:/home/dovahkiin/bin:/home/dovahkiin/.nix-profile/bin:/usr/local/bin:/bin
Environment=OPENCLAW_GATEWAY_PORT=50288
Environment=OPENCLAW_SYSTEMD_UNIT=openclaw-gateway.service
Environment="OPENCLAW_WINDOWS_TASK_NAME=OpenClaw Gateway"
Environment=OPENCLAW_SERVICE_MARKER=openclaw
Environment=OPENCLAW_SERVICE_KIND=gateway
Environment=OPENCLAW_SERVICE_VERSION=2026.5.22

[Install]
WantedBy=default.target
